{
  "name": "suzie-doctor-connector",
  "version": "0.1.6-dev",
  "interface_version": 1,
  "canonical_core": true,
  "treatment_path": "doctor.diagnose|doctor.action.request -> signed_execution_package -> ProtocolEngine",
  "tools": [
    {
      "name": "doctor.capabilities",
      "risk": "read_only",
      "description": "Return Connector capability families, canonical tools, Suite compatibility and supported ProtocolEngine primitives.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "adapter_id": "doctor.core",
      "family": "doctor",
      "target_policy": "none",
      "target_fields": [],
      "checkpoint_support": false,
      "rollback_support": false,
      "confirmation_class": "none"
    },
    {
      "name": "doctor.suite",
      "risk": "read_only",
      "description": "Return bundled Suite/App/Connector/Skill/Protocol/Bridge/Server-API compatibility status.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "adapter_id": "doctor.core",
      "family": "doctor",
      "target_policy": "none",
      "target_fields": [],
      "checkpoint_support": false,
      "rollback_support": false,
      "confirmation_class": "none"
    },
    {
      "name": "doctor.skill",
      "risk": "read_only",
      "description": "Return the canonical Doctor Skill descriptor and, when requested, the canonical SKILL text.",
      "input_schema": {
        "type": "object",
        "properties": {
          "include_text": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      },
      "adapter_id": "doctor.core",
      "family": "doctor",
      "target_policy": "none",
      "target_fields": [],
      "checkpoint_support": false,
      "rollback_support": false,
      "confirmation_class": "none"
    },
    {
      "name": "doctor.diagnose",
      "risk": "signed_treatment",
      "arguments": [
        "evidence",
        "execute",
        "risk_assessment"
      ],
      "description": "Consult Doctor Server and optionally execute only a validated signed treatment after Suzie Doctor supplies its own contextual autonomous risk assessment.",
      "input_schema": {
        "type": "object",
        "properties": {
          "evidence": {
            "type": "object"
          },
          "execute": {
            "type": "boolean",
            "default": false
          },
          "risk_assessment": {
            "type": "object",
            "properties": {
              "harm_probability": {
                "type": "string",
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH"
                ]
              },
              "irreversibility": {
                "type": "string",
                "enum": [
                  "REVERSIBLE",
                  "PARTIALLY_REVERSIBLE",
                  "IRREVERSIBLE"
                ]
              },
              "harm_magnitude": {
                "type": "string",
                "enum": [
                  "LOW",
                  "MODERATE",
                  "SUBSTANTIAL",
                  "CATASTROPHIC"
                ]
              },
              "decision": {
                "type": "string",
                "enum": [
                  "PROCEED",
                  "AVOID"
                ]
              },
              "rationale": {
                "type": "string"
              }
            },
            "required": [
              "harm_probability",
              "irreversibility",
              "harm_magnitude",
              "decision",
              "rationale"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "evidence"
        ],
        "additionalProperties": false
      },
      "adapter_id": "doctor.core",
      "family": "doctor",
      "target_policy": "signed_execution_package",
      "target_fields": [],
      "checkpoint_support": "protocol_defined",
      "rollback_support": "protocol_defined",
      "confirmation_class": "autonomous_risk_review",
      "decision_source": "suzie_doctor_autonomous_risk_assessment"
    },
    {
      "name": "doctor.action.request",
      "risk": "signed_treatment",
      "arguments": [
        "action",
        "exact_target",
        "reason",
        "evidence",
        "risk_assessment",
        "expected_result",
        "verify_criterion",
        "checkpoint",
        "rollback",
        "fallback"
      ],
      "description": "Field-Suzie only request for a signed one-shot structured action when no suitable known Protocol treatment exists. Requires exact target, autonomous risk assessment and mandatory functional verify.",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "object"
          },
          "exact_target": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "object"
          },
          "risk_assessment": {
            "type": "object"
          },
          "expected_result": {
            "type": "string"
          },
          "verify_criterion": {
            "type": "object"
          },
          "checkpoint": {
            "type": [
              "object",
              "null"
            ]
          },
          "rollback": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "fallback": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "action",
          "exact_target",
          "reason",
          "evidence",
          "risk_assessment",
          "expected_result",
          "verify_criterion"
        ],
        "additionalProperties": false
      },
      "adapter_id": "doctor.core",
      "family": "doctor",
      "target_policy": "exact_argument",
      "target_fields": [
        "exact_target"
      ],
      "checkpoint_support": "protocol_defined",
      "rollback_support": "protocol_defined",
      "confirmation_class": "autonomous_risk_review",
      "decision_source": "suzie_doctor_autonomous_risk_assessment"
    },
